<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.yupiik.ai</groupId>
    <artifactId>bot-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>bot-gateway</artifactId>
  <name>Yupiik AI :: Coding Agent :: Extensions :: Bots :: Gateway</name>
  <description>Provider-neutral fixed TLS services and bounded public dependency egress gateways.</description>
  <properties>
    <bot-gateway.services.base-image>eclipse-temurin:25-jre</bot-gateway.services.base-image>
    <bot-gateway.services.image>yca-services:local</bot-gateway.services.image>
    <bot-gateway.image.architecture>${jib.arch}</bot-gateway.image.architecture>
    <bot.image.architecture>${bot-gateway.image.architecture}</bot.image.architecture>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.yupiik.ai</groupId>
      <artifactId>bot-gateway-transport</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.yupiik.ai</groupId>
      <artifactId>core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-json</artifactId>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-build-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-processor</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>image-services</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.google.cloud.tools</groupId>
            <artifactId>jib-maven-plugin</artifactId>
            <configuration>
              <from>
                <image>${bot-gateway.services.base-image}</image>
              </from>
              <to>
                <image>${bot-gateway.services.image}</image>
              </to>
              <container>
                <mainClass>io.yupiik.ia.agent.bot.gateway.ProviderServicesGateway</mainClass>
                <jvmFlags combine.children="append">
                  <jvmFlag>-Xmx128m</jvmFlag>
                </jvmFlags>
              </container>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
