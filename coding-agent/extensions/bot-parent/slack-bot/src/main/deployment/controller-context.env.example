# Separate Docker --env-file overlay, applied AFTER controller.env.
# Not read automatically by the base launcher. See context.adoc launcher changes.
# Start disabled; enable only after assembled tests and separate operator approval.
SLACK_CONTEXT_ENABLED=false
# Explicit operator risk acceptance only; does not change mounts or the launcher.
SLACK_CONTEXT_ALLOWSWAPBACKEDTMPFS=false
# Separate explicit acceptance of persistent agent stdout/stderr; keep false normally.
# For docker logs, set this true AND SLACK_EXECUTOR_DOCKER_DISABLECONTAINERLOGS=false.
SLACK_CONTEXT_ALLOWCONTAINERLOGS=false
SLACK_CONTEXT_RESOLVEMENTIONS=true
SLACK_CONTEXT_SEARCHENABLED=false
SLACK_CONTEXT_SOURCECHANNELS=
# Optional public-thread scope/token qualification is required before enabling.
# This allowlist is independent of search sources and never changes admission.
SLACK_CONTEXT_THREAD_ENABLED=false
SLACK_CONTEXT_THREAD_CHANNELS=
# Initial snapshot only; cumulative thread pages share messages/bytes/calls below.
SLACK_CONTEXT_THREAD_INITIALMESSAGES=20
SLACK_CONTEXT_THREAD_MAXMESSAGES=100
SLACK_CONTEXT_THREAD_MAXBYTES=65536
SLACK_CONTEXT_THREAD_MAXREQUESTS=3
SLACK_CONTEXT_THREAD_LOOKBACKHOURS=24
SLACK_CONTEXT_MAXMEMBERS=8
# Overall calls/bytes include thread prefetch and explicit opaque-token pages.
SLACK_CONTEXT_MAXREQUESTS=12
SLACK_CONTEXT_MAXRESULTS=5
SLACK_CONTEXT_MAXRESPONSEBYTES=131072
SLACK_CONTEXT_MAXCONCURRENT=1
# Absolute admission deadline; queue delay consumes it and recovery restores no grant.
SLACK_CONTEXT_ACTIONRETENTIONSECONDS=600
SLACK_EXECUTOR_BACKEND=DOCKER
SLACK_EXECUTOR_ATTEMPTROOT=/run/yca-slack-context-attempts
SLACK_EXECUTOR_SHOWTOOLOUTPUT=hidden
# Neutral shared docker.disableContainerLogs property; default elsewhere is false.
SLACK_EXECUTOR_DOCKER_DISABLECONTAINERLOGS=true
# Preserve the explicitly configured dependencyEgress policy from controller.env.
# Context does not enable egress or add hosts. Approved CONNECT targets can receive data.
# Preserve only trusted operator MCP/search settings and credentials; remote retention
# requires separate acceptance and is not erased by transient local attempt cleanup.
# No admission/channel/requester changes, credentials, tracing or cache settings here.
