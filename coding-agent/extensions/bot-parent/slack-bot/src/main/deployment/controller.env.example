# Trusted controller environment, not an agent environment or shell script.
# Keep root-owned 0600. Empty channel lists always admit nobody.
# Headless controller: keep JUL on ordinary process streams, not terminal ownership routing.
YCA_LOGGING_AUTO=false
SLACK_WORKSPACE=T_REPLACE_WITH_EXACT_ID
SLACK_BOTUSER=U_REPLACE_WITH_BOT_USER_ID
SLACK_CHANNELS=
SLACK_USERS=
# Explicit opt-in for all members of the exact allowed channels; verify the
# private channel audience first. With false, empty SLACK_USERS denies all.
SLACK_ALLOWCHANNELMEMBERS=false
SLACK_ALLOWSLACKCONNECT=false
SLACK_HOME=/var/lib/yca-slack/state
SLACK_AGENTCONFIGURATION=/etc/yca-slack/agent.json
SLACK_MAXPENDING=20
SLACK_MAXPENDINGPERUSER=2
SLACK_MAXINPUTCHARS=16000
SLACK_MAXANSWERCHARS=12000
SLACK_QUESTIONTIMEOUTSECONDS=600
SLACK_RETENTIONSECONDS=2592000
SLACK_EXECUTOR_BACKEND=DOCKER
SLACK_EXECUTOR_ATTEMPTROOT=/var/lib/yca-slack/attempts
SLACK_EXECUTOR_TIMEOUTSECONDS=900
SLACK_EXECUTOR_COMMANDTIMEOUTSECONDS=30
SLACK_EXECUTOR_SHOWTOOLOUTPUT=hidden
SLACK_EXECUTOR_DOCKER_EXECUTABLE=/usr/bin/docker
SLACK_EXECUTOR_DOCKER_IMAGE=REPLACE_WITH_VETTED_SLACK_AGENT_IMAGE_AT_SHA256_DIGEST
# Inference-only restricted services. Provision the control bridge/upstream;
# never attach agents to it. Do not set docker.network or standalone docker.egress.
SLACK_EXECUTOR_DOCKER_SERVICES_IMAGE=REPLACE_WITH_VETTED_BOT_GATEWAY_SERVICES_IMAGE_AT_SHA256_DIGEST
SLACK_EXECUTOR_DOCKER_SERVICES_CONTROLNETWORK=yca-slack-control
SLACK_EXECUTOR_DOCKER_SERVICES_KEYSTORE=/etc/yca-slack/tls/services.p12
SLACK_EXECUTOR_DOCKER_SERVICES_KEYSTOREPASSWORDENV=YCA_SERVICES_KEYSTORE_PASSWORD
SLACK_EXECUTOR_DOCKER_SERVICES_SERVERNAME=attempt-services.yca.internal
# Planning address only: match the approved upstream and agent.json exactly.
SLACK_EXECUTOR_DOCKER_SERVICES_PROVIDERTARGET=http://172.30.50.10:8080/v1
# Omission enables shared public dependency-host defaults; disable explicitly.
SLACK_EXECUTOR_DOCKER_SERVICES_DEPENDENCYEGRESS_ENABLED=false
# Cooperative common budget: every participating controller must match these.
# Pre-provision a controller-only setgid root, disjoint from state and attempts.
BOT_ADMISSION_ROOT=/var/lib/yca-bots/admission
BOT_ADMISSION_SLOTS=1
BOT_ADMISSION_TRUSTEDGROUP=yca-bots
# Optional managed provider request cap, separate from attempt admission.
# Uncomment all three only after provisioning a private same-UID local root.
# The wrapper bind-mounts the root at its identical host path; gateways alone
# mount it at /services/budget. Agents never receive the root or variables.
# YCA_PROVIDER_BUDGET_ROOT=/var/lib/yca-bots/provider-requests
# YCA_PROVIDER_BUDGET_ID=operator-assigned-provider-account
# YCA_PROVIDER_BUDGET_SLOTS=1
# No secret values here. Wrapper loads Slack tokens, OPENAI_API_KEY and
# YCA_SERVICES_KEYSTORE_PASSWORD via systemd credentials; none goes to agents.
