{
  "display_information": {
    "name": "YCA Slack assistant",
    "description": "Explicitly authorized, mentioned requests in threads"
  },
  "features": {
    "bot_user": {
      "display_name": "YCA",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["app_mentions:read", "chat:write"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
