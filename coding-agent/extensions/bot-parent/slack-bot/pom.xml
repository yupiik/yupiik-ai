<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.yupiik.ai</groupId>
    <artifactId>bot-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>slack-bot</artifactId>
  <name>Yupiik AI :: Coding Agent :: Extensions :: Bots :: Slack Bot</name>
  <properties>
    <slack-bot.image.architecture>${jib.arch}</slack-bot.image.architecture>
    <bot.image.architecture>${slack-bot.image.architecture}</bot.image.architecture>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.yupiik.ai</groupId>
      <artifactId>bot-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.yupiik.ai</groupId>
      <artifactId>bot-gateway</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-build-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-processor</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <compilerArg>-Afusion.moduleFqn=io.yupiik.ia.agent.slack.SlackBotModule</compilerArg>
          </compilerArgs>
        </configuration>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs combine.self="override">
                <compilerArg>-Xlint:all,-serial,-this-escape,-missing-explicit-ctor,-processing</compilerArg>
                <compilerArg>-Werror</compilerArg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>fatjar</id>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>fatjar</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <transformer implementation="io.yupiik.maven.shade.transformer.FusionDocumentationTransformer" />
                <transformer implementation="io.yupiik.maven.shade.transformer.FusionJsonSchemaTransformer" />
                <transformer implementation="io.yupiik.maven.shade.transformer.FusionOpenRPCTransformer" />
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.yupiik.fusion.framework.api.main.CliLauncher</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <!-- Ordinary builds never create images. Only image-all opts into package bindings. -->
  <profiles>
    <profile>
      <id>image-all</id>
      <properties>
        <slack-bot.images.goal>dockerBuild</slack-bot.images.goal>
        <slack-bot.controller.image>yca-slack-controller:local</slack-bot.controller.image>
        <slack-bot.agent.image>yca-slack-agent:local</slack-bot.agent.image>
        <slack-bot.services.image>yca-services:local</slack-bot.services.image>
        <slack-bot.egress.image>yca-egress:local</slack-bot.egress.image>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.7.0</version>
            <executions>
              <execution>
                <id>require-all-image-bases</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <phase>validate</phase>
                <configuration>
                  <rules>
                    <requireProperty>
                      <property>slack-bot.controller.base-image</property>
                      <message>Supply an operator-vetted JDK 25 base with a native Docker CLI, pinned by sha256 digest.</message>
                      <regex>[^\s]+@sha256:[a-f0-9]{64}</regex>
                    </requireProperty>
                    <requireProperty>
                      <property>slack-bot.agent.base-image</property>
                      <message>Supply an operator-vetted credential-free JDK 25 and development toolchain base, pinned by sha256 digest.</message>
                      <regex>[^\s]+@sha256:[a-f0-9]{64}</regex>
                    </requireProperty>
                    <requireProperty>
                      <property>slack-bot.services.base-image</property>
                      <message>Supply an operator-vetted JDK/JRE 25 services base, pinned by sha256 digest.</message>
                      <regex>[^\s]+@sha256:[a-f0-9]{64}</regex>
                    </requireProperty>
                    <requireProperty>
                      <property>slack-bot.egress.base-image</property>
                      <message>Supply an operator-vetted JDK/JRE 25 egress base, pinned by sha256 digest.</message>
                      <regex>[^\s]+@sha256:[a-f0-9]{64}</regex>
                    </requireProperty>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>com.google.cloud.tools</groupId>
            <artifactId>jib-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>controller-image</id>
                <goals>
                  <goal>${slack-bot.images.goal}</goal>
                </goals>
                <phase>package</phase>
                <configuration>
                  <from>
                    <image>${slack-bot.controller.base-image}</image>
                  </from>
                  <to>
                    <image>${slack-bot.controller.image}</image>
                  </to>
                  <container>
                    <jvmFlags combine.children="append">
                      <jvmFlag>-Xmx512m</jvmFlag>
                    </jvmFlags>
                    <environment>
                      <HOME>/tmp</HOME>
                    </environment>
                  </container>
                  <outputPaths>
                    <tar>${project.build.directory}/jib-controller-image.tar</tar>
                    <digest>${project.build.directory}/jib-controller-image.digest</digest>
                    <imageId>${project.build.directory}/jib-controller-image.id</imageId>
                  </outputPaths>
                </configuration>
              </execution>
              <execution>
                <id>agent-image</id>
                <goals>
                  <goal>${slack-bot.images.goal}</goal>
                </goals>
                <phase>package</phase>
                <configuration>
                  <from>
                    <image>${slack-bot.agent.base-image}</image>
                  </from>
                  <to>
                    <image>${slack-bot.agent.image}</image>
                  </to>
                  <container>
                    <environment>
                      <HOME>/attempt/storage</HOME>
                      <MAVEN_CONFIG>/attempt/storage/.m2</MAVEN_CONFIG>
                      <MAVEN_OPTS>-Duser.home=/attempt/storage</MAVEN_OPTS>
                    </environment>
                  </container>
                  <outputPaths>
                    <tar>${project.build.directory}/jib-agent-image.tar</tar>
                    <digest>${project.build.directory}/jib-agent-image.digest</digest>
                    <imageId>${project.build.directory}/jib-agent-image.id</imageId>
                  </outputPaths>
                </configuration>
              </execution>
              <execution>
                <id>services-image</id>
                <goals>
                  <goal>${slack-bot.images.goal}</goal>
                </goals>
                <phase>package</phase>
                <configuration>
                  <from>
                    <image>${slack-bot.services.base-image}</image>
                  </from>
                  <to>
                    <image>${slack-bot.services.image}</image>
                  </to>
                  <container>
                    <mainClass>io.yupiik.ia.agent.bot.gateway.ProviderServicesGateway</mainClass>
                    <user>10001:10001</user>
                    <jvmFlags combine.children="append">
                      <jvmFlag>-Xmx128m</jvmFlag>
                    </jvmFlags>
                  </container>
                  <outputPaths>
                    <tar>${project.build.directory}/jib-services-image.tar</tar>
                    <digest>${project.build.directory}/jib-services-image.digest</digest>
                    <imageId>${project.build.directory}/jib-services-image.id</imageId>
                  </outputPaths>
                </configuration>
              </execution>
              <execution>
                <id>egress-image</id>
                <goals>
                  <goal>${slack-bot.images.goal}</goal>
                </goals>
                <phase>package</phase>
                <configuration>
                  <from>
                    <image>${slack-bot.egress.base-image}</image>
                  </from>
                  <to>
                    <image>${slack-bot.egress.image}</image>
                  </to>
                  <container>
                    <mainClass>io.yupiik.ia.agent.bot.gateway.EgressGateway</mainClass>
                    <user>65532:65532</user>
                    <jvmFlags combine.children="append">
                      <jvmFlag>-Xmx128m</jvmFlag>
                    </jvmFlags>
                  </container>
                  <outputPaths>
                    <tar>${project.build.directory}/jib-egress-image.tar</tar>
                    <digest>${project.build.directory}/jib-egress-image.digest</digest>
                    <imageId>${project.build.directory}/jib-egress-image.id</imageId>
                  </outputPaths>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>image-controller</id>
      <properties>
        <slack-bot.controller.image>yca-slack-controller:local</slack-bot.controller.image>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.7.0</version>
            <executions>
              <execution>
                <id>require-controller-base</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <phase>validate</phase>
                <configuration>
                  <rules>
                    <requireProperty>
                      <property>slack-bot.controller.base-image</property>
                      <message>Supply an operator-vetted JDK 25 base with a native Docker CLI, pinned by sha256 digest.</message>
                      <regex>[^\s]+@sha256:[a-f0-9]{64}</regex>
                    </requireProperty>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>com.google.cloud.tools</groupId>
            <artifactId>jib-maven-plugin</artifactId>
            <configuration>
              <from>
                <image>${slack-bot.controller.base-image}</image>
              </from>
              <to>
                <image>${slack-bot.controller.image}</image>
              </to>
              <container>
                <jvmFlags combine.children="append">
                  <jvmFlag>-Xmx512m</jvmFlag>
                </jvmFlags>
                <environment>
                  <HOME>/tmp</HOME>
                </environment>
              </container>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>image-agent</id>
      <properties>
        <slack-bot.agent.image>yca-slack-agent:local</slack-bot.agent.image>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.7.0</version>
            <executions>
              <execution>
                <id>require-agent-base</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <phase>validate</phase>
                <configuration>
                  <rules>
                    <requireProperty>
                      <property>slack-bot.agent.base-image</property>
                      <message>Supply an operator-vetted credential-free JDK 25 and development toolchain base, pinned by sha256 digest.</message>
                      <regex>[^\s]+@sha256:[a-f0-9]{64}</regex>
                    </requireProperty>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>com.google.cloud.tools</groupId>
            <artifactId>jib-maven-plugin</artifactId>
            <configuration>
              <from>
                <image>${slack-bot.agent.base-image}</image>
              </from>
              <to>
                <image>${slack-bot.agent.image}</image>
              </to>
              <container>
                <environment>
                  <HOME>/attempt/storage</HOME>
                  <MAVEN_CONFIG>/attempt/storage/.m2</MAVEN_CONFIG>
                  <MAVEN_OPTS>-Duser.home=/attempt/storage</MAVEN_OPTS>
                </environment>
              </container>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
