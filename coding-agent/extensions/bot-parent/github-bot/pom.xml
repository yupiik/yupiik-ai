<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.yupiik.ai</groupId>
    <artifactId>bot-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>github-bot</artifactId>
  <name>Yupiik AI :: Coding Agent :: Extensions :: Bots :: GitHub Bot</name>
  <properties>
    <github-bot.images.goal>dockerBuild</github-bot.images.goal>
    <github-bot.image.architecture>${jib.arch}</github-bot.image.architecture>
    <bot.image.architecture>${github-bot.image.architecture}</bot.image.architecture>
    <!-- Prebuilt manually from src/main/docker/Dockerfile.dispatcher; Maven never builds that recipe. -->
    <!-- Verified registry index: linux/amd64 plus provenance; no ARM64 image is published yet. -->
    <github-bot.dispatcher.base-image>rmannibucau/github-dispatcher-base:25.0.5.0.3-zulu-debian12-docker29.9.2-git1@sha256:a7c49aa4e71618340c0abff2a5ab19afff9c53380e616535ed2f8f247efcde36</github-bot.dispatcher.base-image>
    <github-bot.dispatcher.image>yca-github-dispatcher:local</github-bot.dispatcher.image>
    <!-- No agent base default: supply a vetted JDK 25 and development toolchain image. -->
    <github-bot.agent.image>yca-github-agent:local</github-bot.agent.image>
    <github-bot.egress.base-image>eclipse-temurin:25-jre</github-bot.egress.base-image>
    <github-bot.egress.image>yca-egress:local</github-bot.egress.image>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.yupiik.ai</groupId>
      <artifactId>bot-gateway-transport</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.yupiik.ai</groupId>
      <artifactId>testing</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.yupiik.ai</groupId>
      <artifactId>bot-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.yupiik.ai</groupId>
      <artifactId>bot-gateway</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.yupiik.ai</groupId>
      <artifactId>core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-build-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-processor</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-kubernetes-client</artifactId>
      <version>${fusion.version}</version>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-http-server-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-http-server-jre</artifactId>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <pluginManagement>
      <plugins />
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <compilerArg>-Afusion.moduleFqn=io.yupiik.ia.agent.github.GithubBotModule</compilerArg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>fatjar</id>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>fatjar</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <transformer implementation="io.yupiik.maven.shade.transformer.FusionDocumentationTransformer" />
                <transformer implementation="io.yupiik.maven.shade.transformer.FusionJsonSchemaTransformer" />
                <transformer implementation="io.yupiik.maven.shade.transformer.FusionOpenRPCTransformer" />
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.yupiik.fusion.framework.api.main.CliLauncher</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <!-- Ordinary builds never create images. Only image-all opts into package bindings. -->
  <profiles>
    <profile>
      <id>image-all</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>require-agent-base</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <phase>validate</phase>
                <configuration>
                  <rules>
                    <requireProperty>
                      <property>github-bot.agent.base-image</property>
                      <message>Supply -Dgithub-bot.agent.base-image with a vetted JDK 25 and development toolchain image.</message>
                      <regex>.*\S.*</regex>
                      <regexMessage>The agent base image must not be blank.</regexMessage>
                    </requireProperty>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>com.google.cloud.tools</groupId>
            <artifactId>jib-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>dispatcher-image</id>
                <goals>
                  <goal>${github-bot.images.goal}</goal>
                </goals>
                <phase>package</phase>
                <configuration>
                  <from>
                    <image>${github-bot.dispatcher.base-image}</image>
                  </from>
                  <to>
                    <image>${github-bot.dispatcher.image}</image>
                  </to>
                  <container>
                    <environment>
                      <HOME>/tmp</HOME>
                    </environment>
                  </container>
                  <outputPaths>
                    <tar>${project.build.directory}/jib-dispatcher-image.tar</tar>
                    <digest>${project.build.directory}/jib-dispatcher-image.digest</digest>
                    <imageId>${project.build.directory}/jib-dispatcher-image.id</imageId>
                  </outputPaths>
                </configuration>
              </execution>
              <execution>
                <id>agent-image</id>
                <goals>
                  <goal>${github-bot.images.goal}</goal>
                </goals>
                <phase>package</phase>
                <configuration>
                  <from>
                    <image>${github-bot.agent.base-image}</image>
                  </from>
                  <to>
                    <image>${github-bot.agent.image}</image>
                  </to>
                  <container>
                    <environment>
                      <HOME>/attempt/storage</HOME>
                      <MAVEN_CONFIG>/attempt/storage/.m2</MAVEN_CONFIG>
                      <MAVEN_OPTS>-Duser.home=/attempt/storage</MAVEN_OPTS>
                    </environment>
                  </container>
                  <outputPaths>
                    <tar>${project.build.directory}/jib-agent-image.tar</tar>
                    <digest>${project.build.directory}/jib-agent-image.digest</digest>
                    <imageId>${project.build.directory}/jib-agent-image.id</imageId>
                  </outputPaths>
                </configuration>
              </execution>
              <execution>
                <id>egress-image</id>
                <goals>
                  <goal>${github-bot.images.goal}</goal>
                </goals>
                <phase>package</phase>
                <configuration>
                  <from>
                    <image>${github-bot.egress.base-image}</image>
                  </from>
                  <to>
                    <image>${github-bot.egress.image}</image>
                  </to>
                  <container>
                    <mainClass>io.yupiik.ia.agent.bot.gateway.EgressGateway</mainClass>
                    <user>65532:65532</user>
                    <jvmFlags combine.children="append">
                      <jvmFlag>-Xmx128m</jvmFlag>
                    </jvmFlags>
                  </container>
                  <outputPaths>
                    <tar>${project.build.directory}/jib-egress-image.tar</tar>
                    <digest>${project.build.directory}/jib-egress-image.digest</digest>
                    <imageId>${project.build.directory}/jib-egress-image.id</imageId>
                  </outputPaths>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>image-dispatcher</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.google.cloud.tools</groupId>
            <artifactId>jib-maven-plugin</artifactId>
            <configuration>
              <from>
                <image>${github-bot.dispatcher.base-image}</image>
              </from>
              <to>
                <image>${github-bot.dispatcher.image}</image>
              </to>
              <container>
                <environment>
                  <HOME>/tmp</HOME>
                </environment>
              </container>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>image-agent</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>require-agent-base</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <phase>validate</phase>
                <configuration>
                  <rules>
                    <requireProperty>
                      <property>github-bot.agent.base-image</property>
                      <message>Supply -Dgithub-bot.agent.base-image with a vetted JDK 25 and development toolchain image.</message>
                      <regex>.*\S.*</regex>
                      <regexMessage>The agent base image must not be blank.</regexMessage>
                    </requireProperty>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>com.google.cloud.tools</groupId>
            <artifactId>jib-maven-plugin</artifactId>
            <configuration>
              <from>
                <image>${github-bot.agent.base-image}</image>
              </from>
              <to>
                <image>${github-bot.agent.image}</image>
              </to>
              <container>
                <environment>
                  <HOME>/attempt/storage</HOME>
                  <MAVEN_CONFIG>/attempt/storage/.m2</MAVEN_CONFIG>
                  <MAVEN_OPTS>-Duser.home=/attempt/storage</MAVEN_OPTS>
                </environment>
              </container>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>image-egress</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.google.cloud.tools</groupId>
            <artifactId>jib-maven-plugin</artifactId>
            <configuration>
              <from>
                <image>${github-bot.egress.base-image}</image>
              </from>
              <to>
                <image>${github-bot.egress.image}</image>
              </to>
              <container>
                <mainClass>io.yupiik.ia.agent.bot.gateway.EgressGateway</mainClass>
                <user>65532:65532</user>
                <jvmFlags combine.children="append">
                  <jvmFlag>-Xmx128m</jvmFlag>
                </jvmFlags>
              </container>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
