<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.yupiik.ai</groupId>
    <artifactId>maven-repository-indexer-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>maven-repository-knowledge-mcp</artifactId>
  <packaging>jar</packaging>
  <name>Yupiik AI :: Coding Agent :: Extensions :: Maven Repository Indexer :: Knowledge MCP</name>
  <description>Reusable fusion-mcp-server presentation exposing the maven-repository-knowledge pipeline as MCP tools for any MCP client.</description>
  <dependencies>
    <dependency>
      <groupId>io.yupiik.ai</groupId>
      <artifactId>mcp-client</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.yupiik.ai</groupId>
      <artifactId>maven-repository-knowledge</artifactId>
    </dependency>
    <dependency>
      <groupId>io.yupiik.ai</groupId>
      <artifactId>mcp-server</artifactId>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-build-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-processor</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-json</artifactId>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-httpclient</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-testing</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <compilerArg>-Afusion.moduleFqn=io.yupiik.maven.knowledge.mcp.MavenKnowledgeMcpModule</compilerArg>
          </compilerArgs>
        </configuration>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs combine.self="override">
                <compilerArg>-Xlint:all,-serial,-this-escape,-missing-explicit-ctor,-processing</compilerArg>
                <compilerArg>-Werror</compilerArg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- the fake .m2 + fake project the @FusionSupport MCP server boots against,
                 they are populated by the test before the tools are called -->
            <yca.maven.localRepository>${project.build.directory}/mcp-test-m2/repository</yca.maven.localRepository>
            <yca.maven.projectDir>${project.build.directory}/mcp-test-project</yca.maven.projectDir>
          </systemPropertyVariables>
          <environmentVariables>
            <!-- any tool path that spawns `mvn` on PATH gets the fake script
                 (src/test/resources/fake-mvn/bin) instead of the real build tool so the
                 tests stay fast and hermetic. `Path` is the Windows key, `PATH` the
                 POSIX one; the unused key is a no-op on the other OS. -->
            <Path>${project.build.testOutputDirectory}/fake-mvn/bin;${env.Path}</Path>
            <PATH>${project.build.testOutputDirectory}/fake-mvn/bin:${env.PATH}</PATH>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
