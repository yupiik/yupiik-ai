# Fake Maven used by the MCP server integration tests: replaces the real `mvn` on
# PATH with a constant, deterministic `dependency:list` output so tests never spawn
# the real build tool. See MvnProjectDeps.resolve() (spawns `mvn -o dependency:list`).
echo "[INFO] io.yupiik.fake:fake-util:jar:2.0:provided"
echo "[INFO] io.yupiik.fake:fake-lib:jar:1.0:compile"
exit 0