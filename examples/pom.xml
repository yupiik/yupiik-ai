<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.yupiik.ai</groupId>
    <artifactId>yupiik-ai-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>examples-parent</artifactId>
  <packaging>pom</packaging>
  <name>Yupiik AI :: Examples</name>
  <modules>
    <module>a2a-server</module>
    <module>mcp-server</module>
    <module>protocols-jre</module>
    <module>protocols-tomcat</module>
    <module>acp-stdio</module>
  </modules>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <executable>${java.home}/bin/java</executable>
          <inheritIo>true</inheritIo>
          <arguments>
            <argument>-Dfusion.launcher.useHook=true</argument>
            <argument>-classpath</argument>
            <classpath />
            <argument>io.yupiik.fusion.framework.api.main.Launcher</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
