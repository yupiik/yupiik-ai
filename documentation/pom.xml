          <customScripts>&lt;style&gt;
/* mermaid diagrams: the renderer emits a bare pre.mermaid (roles are
   dropped by visitMermaid), so center diagrams and let them take the full
   available width via a global rule on the pre and its svg. */
pre.mermaid {
  background: transparent;
  text-align: center;
  display: block;
  width: 100%;
  margin: 0;
  padding: .75rem 0;
  overflow-x: auto;
}
pre.mermaid svg {
  display: block;
  max-width: 100%;
  height: auto;
  margin: 0 auto;
}
/* definition-list terms (generated option/command references) */
dt.hdlist1 { font-weight: 600; }
&lt;/style&gt;</customScripts>
